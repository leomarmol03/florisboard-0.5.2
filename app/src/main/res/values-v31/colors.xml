<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Material You: On Android 12 and above the accent colors of the app follow the dynamic color palette of
        the system, which is derived from the wallpaper of the user. The Compose based theme of the settings app
        uses the same palette, so that the whole app looks consistent.
    -->
    <color name="colorPrimary">@android:color/system_accent1_600</color>
    <color name="colorPrimaryDark">@android:color/system_accent1_700</color>
    <color name="colorAccent">@android:color/system_accent1_600</color>
    <color name="colorAccentDark">@android:color/system_accent1_700</color>
    <color name="colorSuccess">@android:color/system_accent3_600</color>
    <color name="colorWarning">@android:color/system_accent2_600</color>
    <color name="colorError">@android:color/system_error_600</color>
    <color name="textColorError">#FFFFFF</color>

    <color name="florisApp_windowBackground">@android:color/system_neutral1_50</color>
</resources>
